"""
Flask Main Application for Machine Condition Monitoring System.
Includes API Ingestion, Telemetry Retrieval, Stats Calculation, UI Routes.
"""

import os
import csv
import math
from datetime import datetime, timezone
from flask import Flask, jsonify, request, render_template
from models import db, MachineReading
from dotenv import load_dotenv

load_dotenv()

app = Flask(__name__)

app.config['SECRET_KEY'] = os.getenv('SECRET_KEY', 'sih2026-secret-key-fallback')
app.config['SQLALCHEMY_DATABASE_URI'] = os.getenv('DATABASE_URL', 'sqlite:///instance/machine_monitoring.db')
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False

db.init_app(app)

@app.before_request
def initialize_database():
    """Ensure database schema is ready and seed initial 40 dataset records if empty."""
    db.create_all()
    if MachineReading.query.count() == 0:
        csv_path = os.path.join(os.path.dirname(__file__), 'data', 'dataset.csv')
        if os.path.exists(csv_path):
            with open(csv_path, mode='r', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                readings = []
                for row in reader:
                    temp_val = float(row['temperature']) if row['temperature'].strip() != '' else None
                    recorded_dt = datetime.strptime(row['recorded_at'], "%Y-%m-%dT%H:%M:%SZ")

                    reading = MachineReading(
                        reading_id=int(row['reading_id']),
                        machine_id=row['machine_id'],
                        vibration=float(row['vibration']),
                        temperature=temp_val,
                        alert_flag=int(row['alert_flag']),
                        recorded_at=recorded_dt
                    )
                    readings.append(reading)
                
                db.session.bulk_save_objects(readings)
                db.session.commit()
                print(f"[SUCCESS] Database initialized & seeded with {len(readings)} records.")

@app.route('/')
def dashboard_view():
    """Renders the HTML Dashboard UI."""
    return render_template('index.html')

@app.route('/health', methods=['GET'])
def health_check():
    """Health check endpoint required by Task 3."""
    try:
        db.session.execute(db.select(1)).scalar()
        return jsonify({"status": "healthy"}), 200
    except Exception as e:
        return jsonify({"status": "unhealthy", "reason": str(e)}), 500

@app.route('/api/readings', methods=['GET'])
def get_readings():
    """Fetch all dataset readings with filtering options."""
    machine_filter = request.args.get('machine_id')
    query = MachineReading.query
    
    if machine_filter:
        query = query.filter_by(machine_id=machine_filter)
        
    readings = query.order_by(MachineReading.reading_id.asc()).all()
    return jsonify({
        "status": "success",
        "count": len(readings),
        "data": [r.to_dict() for r in readings]
    }), 200

@app.route('/api/sensor-data', methods=['POST'])
def receive_sensor_data():
    """Ingest live telemetry payload from Sensing Node."""
    data = request.get_json()
    if not data or 'machine_id' not in data or 'vibration' not in data:
        return jsonify({"status": "error", "message": "Invalid JSON payload"}), 400

    machine_id = data['machine_id']
    vibration = float(data['vibration'])
    temperature = float(data['temperature']) if data.get('temperature') is not None else None

    # Calculate Alert Flag dynamically
    alert_flag = 0
    if (vibration > 5.0) or (temperature is not None and (temperature > 75.0 or temperature > 500.0)):
        alert_flag = 1

    # Auto-increment reading_id
    last_record = MachineReading.query.order_by(MachineReading.reading_id.desc()).first()
    next_id = (last_record.reading_id + 1) if last_record else 1

    new_reading = MachineReading(
        reading_id=next_id,
        machine_id=machine_id,
        vibration=vibration,
        temperature=temperature,
        alert_flag=alert_flag,
        recorded_at=datetime.now(timezone.utc)
    )

    db.session.add(new_reading)
    db.session.commit()

    return jsonify({
        "status": "success",
        "message": "Reading recorded successfully",
        "reading_id": next_id,
        "alert_flag": alert_flag
    }), 201

@app.route('/api/stats', methods=['GET'])
def get_machine_stats():
    """Computes basic telemetry statistical summaries across active machines."""
    machines = ["MCH-01", "MCH-02", "MCH-03"]
    stats_result = {}

    for m in machines:
        records = MachineReading.query.filter_by(machine_id=m).all()
        if not records:
            continue

        vib_values = [r.vibration for r in records]
        # Filter valid clean temperature values (ignoring missing and out-of-range > 150 C)
        temp_values = [r.temperature for r in records if r.temperature is not None and r.temperature <= 150.0]

        mean_vib = sum(vib_values) / len(vib_values)
        mean_temp = sum(temp_values) / len(temp_values) if temp_values else 0.0

        stats_result[m] = {
            "total_readings": len(records),
            "vibration_mean": round(mean_vib, 2),
            "vibration_max": round(max(vib_values), 2),
            "temperature_mean": round(mean_temp, 2),
            "temperature_max": round(max(temp_values), 2) if temp_values else 0.0,
            "alert_count": sum(1 for r in records if r.alert_flag == 1)
        }

    return jsonify({
        "status": "success",
        "stats": stats_result
    }), 200

if __name__ == '__main__':
    port = int(os.getenv('PORT', 5000))
    app.run(host='0.0.0.0', port=port, debug=False)
