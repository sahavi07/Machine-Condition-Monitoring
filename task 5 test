document.addEventListener("DOMContentLoaded", () => {
    initCharts();
    checkSystemHealth();
    fetchTelemetryData();
});

function checkSystemHealth() {
    fetch('/health')
        .then(res => res.json())
        .then(data => {
            const badge = document.getElementById('systemStatusBadge');
            if (data.status === 'healthy') {
                badge.textContent = 'System Operational';
                badge.className = 'badge healthy';
            } else {
                badge.textContent = 'System Degraded';
                badge.className = 'badge error';
            }
        })
        .catch(() => {
            const badge = document.getElementById('systemStatusBadge');
            badge.textContent = 'Connection Offline';
            badge.className = 'badge error';
        });
}

function fetchTelemetryData() {
    const banner = document.getElementById('uiStateBanner');
    const tableBody = document.getElementById('telemetryTableBody');

    // Loading State Representation
    banner.className = 'state-banner info';
    banner.textContent = '⏳ Loading latest telemetry records...';
    banner.classList.remove('hidden');

    fetch('/api/readings')
        .then(response => {
            if (!response.ok) throw new Error("HTTP error " + response.status);
            return response.json();
        })
        .then(payload => {
            banner.classList.add('hidden');
            const data = payload.data;

            // Empty State Representation
            if (!data || data.length === 0) {
                banner.className = 'state-banner info';
                banner.textContent = 'ℹ️ No telemetry records found in database.';
                banner.classList.remove('hidden');
                tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center;">No records available</td></tr>';
                return;
            }

            // Render KPIs, Chart Updates, and Table Rows
            updateKPIs(data);
            updateTable(data);
            updateCharts(data);
        })
        .catch(err => {
            // Error State Representation
            banner.className = 'state-banner error';
            banner.innerHTML = `⚠️ Failed to fetch telemetry data: ${err.message}. <button onclick="fetchTelemetryData()">Retry</button>`;
            banner.classList.remove('hidden');
        });
}

function updateKPIs(data) {
    document.getElementById('kpiTotalReadings').textContent = data.length;
    const machines = new Set(data.map(d => d.machine_id));
    document.getElementById('kpiActiveMachines').textContent = machines.size;
    const alerts = data.filter(d => d.alert_flag === 1).length;
    document.getElementById('kpiAlertCount').textContent = alerts;
}

function updateTable(data) {
    const tableBody = document.getElementById('telemetryTableBody');
    tableBody.innerHTML = '';

    data.slice(-15).reverse().forEach(row => {
        const tr = document.createElement('tr');
        
        let tempDisplay = row.temperature !== null ? row.temperature.toFixed(1) : '<span style="color:#ef4444;">MISSING</span>';
        if (row.temperature > 150.0) {
            tempDisplay = `<span style="color:#eab308;">${row.temperature.toFixed(1)} (OUT OF RANGE)</span>`;
        }

        let statusBadge = '<span class="status-pill normal">NORMAL</span>';
        if (row.alert_flag === 1) {
            statusBadge = '<span class="status-pill alert">ALERT</span>';
        }

        tr.innerHTML = `
            <td>${row.reading_id}</td>
            <td><strong>${row.machine_id}</strong></td>
            <td>${row.vibration.toFixed(2)}</td>
            <td>${tempDisplay}</td>
            <td>${statusBadge}</td>
            <td>${new Date(row.recorded_at).toLocaleTimeString()}</td>
        `;
        tableBody.appendChild(tr);
    });
}

function initCharts() {
    const vibCtx = document.getElementById('vibrationChart').getContext('2d');
    const tempCtx = document.getElementById('temperatureChart').getContext('2d');

    vibChart = new Chart(vibCtx, {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Vibration (mm/s)', data: [], borderColor: '#38bdf8', fill: false }] },
        options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });

    tempChart = new Chart(tempCtx, {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Temperature (°C)', data: [], borderColor: '#ef4444', fill: false }] },
        options: { responsive: true, scales: { y: { beginAtZero: false } } }
    });
}

function updateCharts(data) {
    const labels = data.map(d => `#${d.reading_id}`);
    const vibData = data.map(d => d.vibration);
    const tempData = data.map(d => (d.temperature !== null && d.temperature < 150.0) ? d.temperature : null);

    vibChart.data.labels = labels;
    vibChart.data.datasets[0].data = vibData;
    vibChart.update();

    tempChart.data.labels = labels;
    tempChart.data.datasets[0].data = tempData;
    tempChart.update();
}
